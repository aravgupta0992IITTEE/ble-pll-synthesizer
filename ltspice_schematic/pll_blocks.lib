* ------------------------------------------------------------------
* pll_blocks.lib - behavioral models for the PLL schematic symbols
* Logic levels 0..1 V. Uses global .params from the schematic:
*   ICP, MIS, TRST, F0, KV
* ------------------------------------------------------------------

* Rising-edge D flip-flop with asynchronous reset (reset has priority)
.subckt DFF_PFD D CLK RST Q
RD  CLK clkd 1k
CD  clkd 0 1p
BE  er 0 V=0.25*(1+tanh(40*(V(CLK)-0.5)))*(1+tanh(40*(0.5-V(clkd))))
BM  0 m I=1m*(0.5*(1+tanh(40*(V(er)-0.5)))*V(D)*(1-V(RST))*(1-V(m)) - V(RST)*V(m))
CM  m 0 0.2p
RM  m 0 1G
BQ  Q 0 V=0.5*(1+tanh(40*(V(m)-0.5)))
.ends DFF_PFD

* 2-input AND gate
.subckt AND2 A B Y
BY Y 0 V=V(A)*V(B)
.ends AND2

* Reset delay (anti dead-zone), delay ~ TRST
.subckt DELAY IN OUT
RT IN x {TRST/1p}
CT x 0 1p
BO OUT 0 V=0.5*(1+tanh(40*(V(x)-0.5)))
.ends DELAY

* Charge pump: sources ICP on UP, sinks ICP*(1+MIS) on DN, compliance 0.1..3.2 V
.subckt CHGPUMP UP DN OUT
BC 0 OUT I=ICP*(V(UP)*0.5*(1+tanh(20*(3.2-V(OUT)))) - (1+MIS)*V(DN)*0.5*(1+tanh(20*(V(OUT)-0.1))))
.ends CHGPUMP

* VCO (frequency domain): F output = VCO frequency in MHz
* f = F0 + KV*Vc, tuning range limited to Vc = 0.2..3.1 V
.subckt VCO VC F
BF F 0 V=(F0+KV*min(max(V(VC),0.2),3.1))*1e-6
.ends VCO

* Divide-by-N (phase domain): divider phase integrates f/N, output
* rises each time the phase passes an integer -> exact edge timing
* FIN = frequency in MHz, N = divide ratio (as a voltage)
.subckt DIVN FIN N DIV
BP 0 ph I=V(FIN)*1e6/V(N)
CP ph 0 1 IC=-0.4
RP ph 0 1e15
BO DIV 0 V=0.5+0.5*tanh(30*sin(6.283185307*V(ph)))
.ends DIVN

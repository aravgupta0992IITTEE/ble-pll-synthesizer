TEXT 16 -80 Left 3 ;2.4 GHz Bluetooth LE PLL frequency synthesizer  -  f_out = N x 1 MHz  (N = 2402 ... 2480)
TEXT 160 128 Left 2 ;Phase-Frequency Detector
TEXT 704 320 Left 2 ;Charge pump
TEXT 880 672 Left 2 ;3rd-order loop filter: BW 98 kHz, PM 52 deg
TEXT 1232 544 Left 1 ;f = 2.1 GHz + 150 MHz/V x Vc
TEXT 1184 912 Left 2 ;Divide-by-N (channel select)
TEXT 1504 880 Left 1 ;N steps 2402 -> 2480 at 40 us
TEXT 16 960 Left 2 ;Plot: V(fvco) = VCO frequency in MHz,  V(vc) = tuning voltage,  V(up)/V(dn) = PFD outputs,  V(ref)/V(div)
TEXT 16 1008 Left 2 !.include pll_blocks.lib
TEXT 16 1032 Left 2 !.param F0=2.1G KV=150Meg ICP=1m MIS=0 TRST=2n
